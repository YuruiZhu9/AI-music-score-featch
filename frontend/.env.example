# AI Guitar Tab Transcriber — 前端环境变量示例
# 复制本文件为 .env.local 并修改相应值

# ── API 配置 ───────────────────────────────────────────────────────
# 生产环境：设置为后端部署地址，如 https://api.example.com
# 开发环境（pnpm dev）：留空，默认通过 vite proxy 代理到 localhost:8000
VITE_API_BASE_URL=

# ── 功能开关 ───────────────────────────────────────────────────────
# 设为 1 启用详细调试日志（仅开发模式）
VITE_DEBUG=0

# ── UI 配置 ────────────────────────────────────────────────────────
# 默认乐器类型：guitar | bass
VITE_DEFAULT_INSTRUMENT=guitar
