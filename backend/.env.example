# AI Guitar Tab Transcriber - Environment Variables
# ================================================

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_FILE_SIZE_MB=50

# Celery / Redis (for async task queue)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Demucs (audio separation) - model cache
DEMUCS_MODEL=htdemucs
DEMUCS_EXTRA=''

# Frontend URL (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# GitHub (optional - for auto commit)
GITHUB_TOKEN=
GITHUB_REPO=AI-music-score-featch
